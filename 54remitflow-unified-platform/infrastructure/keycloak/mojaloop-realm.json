{
  "realm": "mojaloop",
  "enabled": true,
  "displayName": "Mojaloop Financial Services",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>Mojaloop</span></div>",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "realm": [
      {
        "name": "super_admin",
        "description": "Super administrator with full system access",
        "composite": true,
        "composites": {
          "realm": ["hub_operator", "auditor"]
        }
      },
      {
        "name": "hub_operator",
        "description": "Hub operator with participant and settlement management",
        "composite": false
      },
      {
        "name": "auditor",
        "description": "Auditor with read-only access to all data",
        "composite": false
      },
      {
        "name": "fsp_admin",
        "description": "FSP administrator with full FSP access",
        "composite": true,
        "composites": {
          "realm": ["fsp_operator", "fsp_viewer"]
        }
      },
      {
        "name": "fsp_operator",
        "description": "FSP operator with transfer and position access",
        "composite": false
      },
      {
        "name": "fsp_viewer",
        "description": "FSP viewer with read-only access",
        "composite": false
      }
    ],
    "client": {
      "mojaloop-services": [
        {
          "name": "initiate_transfer",
          "description": "Can initiate transfers"
        },
        {
          "name": "view_position",
          "description": "Can view positions"
        },
        {
          "name": "adjust_liquidity",
          "description": "Can adjust liquidity"
        },
        {
          "name": "manage_participants",
          "description": "Can manage participants"
        },
        {
          "name": "manage_settlements",
          "description": "Can manage settlements"
        },
        {
          "name": "view_audit_logs",
          "description": "Can view audit logs"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "Hub Operators",
      "path": "/hub-operators",
      "realmRoles": ["hub_operator"]
    },
    {
      "name": "Auditors",
      "path": "/auditors",
      "realmRoles": ["auditor"]
    },
    {
      "name": "FSP Administrators",
      "path": "/fsp-admins",
      "realmRoles": ["fsp_admin"]
    },
    {
      "name": "FSP Operators",
      "path": "/fsp-operators",
      "realmRoles": ["fsp_operator"]
    }
  ],
  "clients": [
    {
      "clientId": "mojaloop-services",
      "name": "Mojaloop Services",
      "description": "Internal Mojaloop services client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MOJALOOP_CLIENT_SECRET}",
      "redirectUris": [],
      "webOrigins": [],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300",
        "saml.assertion.signature": "false",
        "saml.force.post.binding": "false",
        "saml.multivalued.roles": "false",
        "saml.encrypt": "false",
        "saml.server.signature": "false",
        "saml.server.signature.keyinfo.ext": "false",
        "exclude.session.state.from.auth.response": "false",
        "saml_force_name_id_format": "false",
        "saml.client.signature": "false",
        "tls.client.certificate.bound.access.tokens": "false",
        "saml.authnstatement": "false",
        "display.on.consent.screen": "false",
        "saml.onetimeuse.condition": "false"
      },
      "protocolMappers": [
        {
          "name": "fsp_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "fsp_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "fsp_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "usermodel.clientRoleMapping.clientId": "mojaloop-services"
          }
        }
      ]
    },
    {
      "clientId": "mojaloop-admin-ui",
      "name": "Mojaloop Admin UI",
      "description": "Mojaloop administration web interface",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:3000/*",
        "https://admin.mojaloop.local/*",
        "https://admin.mojaloop.io/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://admin.mojaloop.local",
        "https://admin.mojaloop.io"
      ],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "fsp-portal",
      "name": "FSP Portal",
      "description": "Financial Service Provider portal",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:3001/*",
        "https://fsp.mojaloop.local/*",
        "https://fsp.mojaloop.io/*"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "https://fsp.mojaloop.local",
        "https://fsp.mojaloop.io"
      ],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "System",
      "lastName": "Administrator",
      "email": "admin@mojaloop.io",
      "credentials": [
        {
          "type": "password",
          "value": "${ADMIN_PASSWORD}",
          "temporary": true
        }
      ],
      "realmRoles": ["super_admin"],
      "clientRoles": {
        "mojaloop-services": ["manage_participants", "manage_settlements", "view_audit_logs"]
      }
    },
    {
      "username": "hub-operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Hub",
      "lastName": "Operator",
      "email": "hub-operator@mojaloop.io",
      "credentials": [
        {
          "type": "password",
          "value": "${HUB_OPERATOR_PASSWORD}",
          "temporary": true
        }
      ],
      "realmRoles": ["hub_operator"],
      "clientRoles": {
        "mojaloop-services": ["manage_participants", "manage_settlements"]
      }
    },
    {
      "username": "auditor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "System",
      "lastName": "Auditor",
      "email": "auditor@mojaloop.io",
      "credentials": [
        {
          "type": "password",
          "value": "${AUDITOR_PASSWORD}",
          "temporary": true
        }
      ],
      "realmRoles": ["auditor"],
      "clientRoles": {
        "mojaloop-services": ["view_audit_logs"]
      }
    }
  ],
  "scopeMappings": [
    {
      "client": "mojaloop-services",
      "roles": ["hub_operator", "fsp_admin", "fsp_operator"]
    }
  ],
  "clientScopeMappings": {
    "mojaloop-services": [
      {
        "client": "mojaloop-admin-ui",
        "roles": ["initiate_transfer", "view_position", "adjust_liquidity", "manage_participants", "manage_settlements"]
      },
      {
        "client": "fsp-portal",
        "roles": ["initiate_transfer", "view_position"]
      }
    ]
  },
  "smtpServer": {},
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "CLIENT_LOGIN",
    "CLIENT_LOGIN_ERROR",
    "REFRESH_TOKEN",
    "REFRESH_TOKEN_ERROR",
    "INTROSPECT_TOKEN",
    "INTROSPECT_TOKEN_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["en"],
  "defaultLocale": "en",
  "browserFlow": "browser",
  "registrationFlow": "registration",
  "directGrantFlow": "direct grant",
  "resetCredentialsFlow": "reset credentials",
  "clientAuthenticationFlow": "clients",
  "dockerAuthenticationFlow": "docker auth"
}
