# Ray Configuration for Distributed Computing

cluster_name: remittance-ray

# Cloud provider configuration
provider:
    type: local
    head_ip: 127.0.0.1
    worker_ips: []

# Authentication
auth:
    ssh_user: ubuntu
    ssh_private_key: ~/.ssh/id_rsa

# Node configurations
head_node:
    node_config:
        InstanceType: m5.large
        ImageId: ami-0abcdef1234567890
    
    # Ray start command
    ray_start_commands:
        - ray stop
        - ray start --head --port=6379 --object-manager-port=8076 --autoscaling-config=~/ray_bootstrap_config.yaml

worker_nodes:
    node_config:
        InstanceType: m5.large
        ImageId: ami-0abcdef1234567890
    
    min_workers: 0
    max_workers: 10
    initial_workers: 0
    
    # Ray start command
    ray_start_commands:
        - ray stop
        - ray start --address=$RAY_HEAD_IP:6379 --object-manager-port=8076

# Setup commands
setup_commands:
    - pip install -U ray[default]
    - pip install pandas numpy scikit-learn

# File mounts
file_mounts: {}

# Cluster syncing
rsync_exclude:
    - "**/.git"
    - "**/.git/**"

# Initialization commands
initialization_commands: []

# Head setup commands
head_setup_commands: []

# Worker setup commands
worker_setup_commands: []

# Head start commands
head_start_ray_commands:
    - ray stop
    - ray start --head --port=6379 --object-manager-port=8076 --autoscaling-config=~/ray_bootstrap_config.yaml --dashboard-host=0.0.0.0

# Worker start commands
worker_start_ray_commands:
    - ray stop
    - ray start --address=$RAY_HEAD_IP:6379 --object-manager-port=8076
