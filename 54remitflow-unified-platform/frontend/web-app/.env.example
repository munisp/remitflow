# API Configuration
VITE_API_BASE_URL=http://localhost:8020
VITE_PAYMENT_GATEWAY_URL=http://localhost:8021
VITE_SECURITY_MONITORING_URL=http://localhost:8022
VITE_WORKFLOW_ORCHESTRATION_URL=http://localhost:8023
VITE_OCR_SERVICE_URL=http://localhost:8024

# AWS S3 Configuration
VITE_AWS_S3_BUCKET=agent-banking-platform-images
VITE_AWS_REGION=us-east-1
VITE_AWS_CLOUDFRONT_URL=https://cdn.agent-banking-platform.com

# Payment Gateway Keys (Public Keys Only)
VITE_STRIPE_PUBLIC_KEY=pk_test_...
VITE_PAYPAL_CLIENT_ID=...

# Feature Flags
VITE_ENABLE_ECOMMERCE=true
VITE_ENABLE_FRAUD_DETECTION=true
VITE_ENABLE_SECURITY_MONITORING=true
VITE_ENABLE_WORKFLOW_ORCHESTRATION=true

# Application Settings
VITE_APP_NAME=Agent Banking Platform
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development
