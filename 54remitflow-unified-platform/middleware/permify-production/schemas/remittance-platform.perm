// Permify Authorization Schema for Nigerian Remittance Platform
// Version: 1.0.0
// This schema defines all entities, relations, and permissions for the platform

// ============================================================================
// USER ENTITY
// ============================================================================
entity user {}

// ============================================================================
// ORGANIZATION ENTITY
// Represents companies, financial institutions, or business entities
// ============================================================================
entity organization {
    // Relations
    relation owner @user
    relation admin @user
    relation member @user
    relation viewer @user
    
    // Permissions
    permission view = owner or admin or member or viewer
    permission edit = owner or admin
    permission delete = owner
    permission manage_members = owner or admin
    permission invite_members = owner or admin or member
    permission view_analytics = owner or admin
    permission manage_settings = owner or admin
}

// ============================================================================
// ACCOUNT ENTITY
// Represents user accounts (wallet, bank account, etc.)
// ============================================================================
entity account {
    // Relations
    relation owner @user
    relation organization @organization
    relation authorized_user @user
    relation viewer @user
    
    // Permissions
    permission view_balance = owner or authorized_user or organization.admin
    permission view_transactions = owner or authorized_user or organization.admin or viewer
    permission transfer = owner or authorized_user
    permission withdraw = owner
    permission deposit = owner or authorized_user
    permission freeze = organization.admin
    permission close = owner or organization.owner
    permission view_details = owner or authorized_user or organization.admin or viewer
}

// ============================================================================
// TRANSACTION ENTITY
// Represents payment transactions
// ============================================================================
entity transaction {
    // Relations
    relation sender @user
    relation receiver @user
    relation organization @organization
    relation compliance_officer @user
    relation auditor @user
    relation viewer @user
    
    // Permissions
    permission view = sender or receiver or organization.admin or compliance_officer or auditor or viewer
    permission view_details = sender or receiver or organization.admin or compliance_officer or auditor
    permission approve = compliance_officer or organization.admin
    permission reject = compliance_officer or organization.admin
    permission flag_suspicious = compliance_officer or organization.admin
    permission refund = organization.admin
    permission cancel = sender or organization.admin
    permission audit = auditor or organization.admin
}

// ============================================================================
// KYC DOCUMENT ENTITY
// Represents KYC verification documents
// ============================================================================
entity kyc_document {
    // Relations
    relation owner @user
    relation organization @organization
    relation compliance_officer @user
    relation reviewer @user
    relation viewer @user
    
    // Permissions
    permission view = owner or compliance_officer or reviewer or organization.admin or viewer
    permission upload = owner
    permission verify = compliance_officer or reviewer
    permission approve = compliance_officer or organization.admin
    permission reject = compliance_officer or organization.admin
    permission delete = owner or organization.admin
    permission request_update = compliance_officer or reviewer
}

// ============================================================================
// KYC VERIFICATION ENTITY
// Represents KYC verification process
// ============================================================================
entity kyc_verification {
    // Relations
    relation subject @user
    relation organization @organization
    relation compliance_officer @user
    relation reviewer @user
    relation approver @user
    
    // Permissions
    permission view = subject or compliance_officer or reviewer or approver or organization.admin
    permission initiate = subject or organization.admin
    permission review = compliance_officer or reviewer
    permission approve = approver or organization.admin
    permission reject = approver or organization.admin
    permission request_documents = compliance_officer or reviewer
    permission complete = approver or organization.admin
}

// ============================================================================
// PAYMENT CORRIDOR ENTITY
// Represents payment corridors (PAPSS, CIPS, PIX, SWIFT, M-Pesa)
// ============================================================================
entity payment_corridor {
    // Relations
    relation owner @organization
    relation admin @user
    relation operator @user
    relation viewer @user
    
    // Permissions
    permission view = owner.admin or admin or operator or viewer
    permission configure = owner.admin or admin
    permission enable = owner.admin or admin
    permission disable = owner.admin or admin
    permission monitor = owner.admin or admin or operator
    permission view_analytics = owner.admin or admin or operator
}

// ============================================================================
// FRAUD CASE ENTITY
// Represents fraud detection cases
// ============================================================================
entity fraud_case {
    // Relations
    relation organization @organization
    relation investigator @user
    relation reviewer @user
    relation approver @user
    relation viewer @user
    
    // Permissions
    permission view = investigator or reviewer or approver or organization.admin or viewer
    permission investigate = investigator or organization.admin
    permission update = investigator or reviewer
    permission escalate = investigator or reviewer
    permission approve = approver or organization.admin
    permission reject = approver or organization.admin
    permission close = approver or organization.admin
    permission reopen = organization.admin
}

// ============================================================================
// COMPLIANCE POLICY ENTITY
// Represents compliance policies and rules
// ============================================================================
entity compliance_policy {
    // Relations
    relation organization @organization
    relation owner @user
    relation editor @user
    relation viewer @user
    
    // Permissions
    permission view = owner or editor or viewer or organization.admin
    permission edit = owner or organization.admin
    permission activate = owner or organization.admin
    permission deactivate = owner or organization.admin
    permission delete = owner or organization.admin
}

// ============================================================================
// AUDIT LOG ENTITY
// Represents audit logs for compliance
// ============================================================================
entity audit_log {
    // Relations
    relation organization @organization
    relation auditor @user
    relation compliance_officer @user
    relation viewer @user
    
    // Permissions
    permission view = auditor or compliance_officer or organization.admin or viewer
    permission export = auditor or compliance_officer or organization.admin
    permission delete = organization.owner
}

// ============================================================================
// REPORT ENTITY
// Represents financial and compliance reports
// ============================================================================
entity report {
    // Relations
    relation organization @organization
    relation creator @user
    relation viewer @user
    relation editor @user
    
    // Permissions
    permission view = creator or viewer or editor or organization.admin
    permission edit = creator or editor or organization.admin
    permission delete = creator or organization.admin
    permission share = creator or organization.admin
    permission export = creator or viewer or organization.admin
}

// ============================================================================
// NOTIFICATION ENTITY
// Represents system notifications
// ============================================================================
entity notification {
    // Relations
    relation recipient @user
    relation organization @organization
    relation sender @user
    
    // Permissions
    permission view = recipient
    permission mark_read = recipient
    permission delete = recipient
    permission send = sender or organization.admin
}

// ============================================================================
// API KEY ENTITY
// Represents API keys for programmatic access
// ============================================================================
entity api_key {
    // Relations
    relation owner @user
    relation organization @organization
    relation admin @user
    
    // Permissions
    permission view = owner or organization.admin or admin
    permission create = owner or organization.admin
    permission revoke = owner or organization.admin or admin
    permission rotate = owner or organization.admin
}

// ============================================================================
// WEBHOOK ENTITY
// Represents webhook configurations
// ============================================================================
entity webhook {
    // Relations
    relation organization @organization
    relation owner @user
    relation admin @user
    
    // Permissions
    permission view = owner or admin or organization.admin
    permission create = owner or organization.admin
    permission edit = owner or admin or organization.admin
    permission delete = owner or organization.admin
    permission test = owner or admin or organization.admin
}

// ============================================================================
// DASHBOARD ENTITY
// Represents analytics dashboards
// ============================================================================
entity dashboard {
    // Relations
    relation organization @organization
    relation owner @user
    relation viewer @user
    relation editor @user
    
    // Permissions
    permission view = owner or viewer or editor or organization.admin
    permission edit = owner or editor or organization.admin
    permission delete = owner or organization.admin
    permission share = owner or organization.admin
}

// ============================================================================
// SETTLEMENT ENTITY
// Represents settlement processes
// ============================================================================
entity settlement {
    // Relations
    relation organization @organization
    relation initiator @user
    relation approver @user
    relation viewer @user
    
    // Permissions
    permission view = initiator or approver or viewer or organization.admin
    permission initiate = initiator or organization.admin
    permission approve = approver or organization.admin
    permission reject = approver or organization.admin
    permission cancel = initiator or organization.admin
}

// ============================================================================
// LIQUIDITY POOL ENTITY
// Represents liquidity pools for currency exchange
// ============================================================================
entity liquidity_pool {
    // Relations
    relation organization @organization
    relation manager @user
    relation contributor @user
    relation viewer @user
    
    // Permissions
    permission view = manager or contributor or viewer or organization.admin
    permission add_liquidity = manager or contributor or organization.admin
    permission remove_liquidity = manager or organization.admin
    permission configure = manager or organization.admin
    permission view_analytics = manager or viewer or organization.admin
}

// ============================================================================
// EXCHANGE RATE ENTITY
// Represents currency exchange rates
// ============================================================================
entity exchange_rate {
    // Relations
    relation organization @organization
    relation manager @user
    relation viewer @user
    
    // Permissions
    permission view = manager or viewer or organization.admin or organization.member
    permission update = manager or organization.admin
    permission configure_alerts = manager or organization.admin
}

// ============================================================================
// ROLE ENTITY
// Represents custom roles within organizations
// ============================================================================
entity role {
    // Relations
    relation organization @organization
    relation member @user
    relation admin @user
    
    // Permissions
    permission view = member or admin or organization.admin
    permission assign = admin or organization.admin
    permission revoke = admin or organization.admin
    permission edit = admin or organization.admin
    permission delete = organization.admin
}

// ============================================================================
// PERMISSION ENTITY
// Represents granular permissions
// ============================================================================
entity permission {
    // Relations
    relation organization @organization
    relation role @role
    relation admin @user
    
    // Permissions
    permission view = admin or organization.admin
    permission grant = admin or organization.admin
    permission revoke = admin or organization.admin
}

