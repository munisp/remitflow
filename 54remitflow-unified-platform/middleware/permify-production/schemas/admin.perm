// Permify Authorization Schema for Admin Management
// Version: 1.0.0
// This schema defines administrative entities and permissions

// ============================================================================
// SYSTEM ADMIN ENTITY
// Represents system-level administrators
// ============================================================================
entity system_admin {
    // Relations
    relation super_admin @user
    relation admin @user
    relation support @user
    
    // Permissions
    permission manage_all = super_admin
    permission manage_organizations = super_admin or admin
    permission manage_users = super_admin or admin
    permission view_system_logs = super_admin or admin or support
    permission manage_system_settings = super_admin
    permission view_analytics = super_admin or admin
    permission manage_support_tickets = super_admin or admin or support
}

// ============================================================================
// ADMIN PANEL ENTITY
// Represents the administrative interface
// ============================================================================
entity admin_panel {
    // Relations
    relation system_admin @system_admin
    relation organization_admin @user
    relation viewer @user
    
    // Permissions
    permission access = system_admin.super_admin or system_admin.admin or organization_admin
    permission view_dashboard = system_admin.super_admin or system_admin.admin or organization_admin or viewer
    permission manage_users = system_admin.super_admin or system_admin.admin or organization_admin
    permission view_reports = system_admin.super_admin or system_admin.admin or organization_admin or viewer
    permission manage_settings = system_admin.super_admin or system_admin.admin
}

// ============================================================================
// SYSTEM CONFIGURATION ENTITY
// Represents system-wide configuration
// ============================================================================
entity system_configuration {
    // Relations
    relation system_admin @system_admin
    relation editor @user
    relation viewer @user
    
    // Permissions
    permission view = system_admin.super_admin or system_admin.admin or editor or viewer
    permission edit = system_admin.super_admin or system_admin.admin or editor
    permission apply = system_admin.super_admin
    permission rollback = system_admin.super_admin
}

// ============================================================================
// SYSTEM LOG ENTITY
// Represents system-level logs
// ============================================================================
entity system_log {
    // Relations
    relation system_admin @system_admin
    relation auditor @user
    relation viewer @user
    
    // Permissions
    permission view = system_admin.super_admin or system_admin.admin or auditor or viewer
    permission export = system_admin.super_admin or system_admin.admin or auditor
    permission delete = system_admin.super_admin
    permission archive = system_admin.super_admin or system_admin.admin
}

// ============================================================================
// FEATURE FLAG ENTITY
// Represents feature toggles
// ============================================================================
entity feature_flag {
    // Relations
    relation system_admin @system_admin
    relation manager @user
    relation viewer @user
    
    // Permissions
    permission view = system_admin.super_admin or system_admin.admin or manager or viewer
    permission enable = system_admin.super_admin or system_admin.admin or manager
    permission disable = system_admin.super_admin or system_admin.admin or manager
    permission configure = system_admin.super_admin or system_admin.admin
}

// ============================================================================
// MAINTENANCE MODE ENTITY
// Represents system maintenance mode
// ============================================================================
entity maintenance_mode {
    // Relations
    relation system_admin @system_admin
    relation operator @user
    
    // Permissions
    permission view_status = system_admin.super_admin or system_admin.admin or operator
    permission enable = system_admin.super_admin
    permission disable = system_admin.super_admin
    permission schedule = system_admin.super_admin or system_admin.admin
}

// ============================================================================
// BACKUP ENTITY
// Represents system backups
// ============================================================================
entity backup {
    // Relations
    relation system_admin @system_admin
    relation operator @user
    relation viewer @user
    
    // Permissions
    permission view = system_admin.super_admin or system_admin.admin or operator or viewer
    permission create = system_admin.super_admin or system_admin.admin or operator
    permission restore = system_admin.super_admin
    permission delete = system_admin.super_admin
    permission download = system_admin.super_admin or system_admin.admin
}

// ============================================================================
// MONITORING ENTITY
// Represents monitoring and alerting
// ============================================================================
entity monitoring {
    // Relations
    relation system_admin @system_admin
    relation operator @user
    relation viewer @user
    
    // Permissions
    permission view_metrics = system_admin.super_admin or system_admin.admin or operator or viewer
    permission configure_alerts = system_admin.super_admin or system_admin.admin or operator
    permission acknowledge_alerts = system_admin.super_admin or system_admin.admin or operator
    permission view_dashboards = system_admin.super_admin or system_admin.admin or operator or viewer
}

// ============================================================================
// DEPLOYMENT ENTITY
// Represents system deployments
// ============================================================================
entity deployment {
    // Relations
    relation system_admin @system_admin
    relation deployer @user
    relation viewer @user
    
    // Permissions
    permission view = system_admin.super_admin or system_admin.admin or deployer or viewer
    permission deploy = system_admin.super_admin or deployer
    permission rollback = system_admin.super_admin
    permission view_logs = system_admin.super_admin or system_admin.admin or deployer or viewer
}

// ============================================================================
// SECURITY POLICY ENTITY
// Represents security policies
// ============================================================================
entity security_policy {
    // Relations
    relation system_admin @system_admin
    relation security_officer @user
    relation viewer @user
    
    // Permissions
    permission view = system_admin.super_admin or system_admin.admin or security_officer or viewer
    permission edit = system_admin.super_admin or security_officer
    permission activate = system_admin.super_admin
    permission deactivate = system_admin.super_admin
}

// ============================================================================
// RATE LIMIT ENTITY
// Represents API rate limits
// ============================================================================
entity rate_limit {
    // Relations
    relation system_admin @system_admin
    relation manager @user
    relation viewer @user
    
    // Permissions
    permission view = system_admin.super_admin or system_admin.admin or manager or viewer
    permission configure = system_admin.super_admin or system_admin.admin or manager
    permission override = system_admin.super_admin
}

// ============================================================================
// IP WHITELIST ENTITY
// Represents IP whitelisting
// ============================================================================
entity ip_whitelist {
    // Relations
    relation system_admin @system_admin
    relation security_officer @user
    relation viewer @user
    
    // Permissions
    permission view = system_admin.super_admin or system_admin.admin or security_officer or viewer
    permission add = system_admin.super_admin or system_admin.admin or security_officer
    permission remove = system_admin.super_admin or system_admin.admin or security_officer
}

// ============================================================================
// SUPPORT TICKET ENTITY
// Represents customer support tickets
// ============================================================================
entity support_ticket {
    // Relations
    relation system_admin @system_admin
    relation creator @user
    relation assignee @user
    relation viewer @user
    
    // Permissions
    permission view = creator or assignee or system_admin.super_admin or system_admin.admin or system_admin.support or viewer
    permission create = creator
    permission assign = system_admin.super_admin or system_admin.admin or system_admin.support
    permission update = assignee or system_admin.super_admin or system_admin.admin or system_admin.support
    permission close = assignee or system_admin.super_admin or system_admin.admin
    permission reopen = creator or system_admin.super_admin or system_admin.admin
}

