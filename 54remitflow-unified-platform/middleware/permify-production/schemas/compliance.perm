// ============================================================================
// WATCHLIST ENTITY
// Represents watchlists for monitoring
// ============================================================================
entity watchlist {
    // Relations
    relation compliance_officer @compliance_officer
    relation manager @user
    relation viewer @user
    relation organization @organization
    
    // Permissions
    permission view = manager or viewer or compliance_officer.chief_compliance_officer or compliance_officer.senior_officer or compliance_officer.officer or organization.admin
    permission add_entry = manager or compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission remove_entry = manager or compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission update_entry = manager or compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
}

// ============================================================================
// COMPLIANCE AUDIT ENTITY
// Represents compliance audits
// ============================================================================
entity compliance_audit {
    // Relations
    relation compliance_officer @compliance_officer
    relation auditor @user
    relation reviewer @user
    relation organization @organization
    
    // Permissions
    permission view = auditor or reviewer or compliance_officer.chief_compliance_officer or compliance_officer.senior_officer or organization.admin
    permission initiate = compliance_officer.chief_compliance_officer
    permission conduct = auditor or compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission review = reviewer or compliance_officer.chief_compliance_officer
    permission approve = compliance_officer.chief_compliance_officer
    permission export = auditor or compliance_officer.chief_compliance_officer
}

