// ============================================================================
// COMPLIANCE RULE ENTITY
// Represents compliance rules and policies
// ============================================================================
entity compliance_rule {
    // Relations
    relation compliance_officer @compliance_officer
    relation creator @user
    relation editor @user
    relation organization @organization
    
    // Permissions
    permission view = creator or editor or compliance_officer.chief_compliance_officer or compliance_officer.senior_officer or compliance_officer.officer or organization.admin
    permission create = compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission edit = creator or editor or compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission activate = compliance_officer.chief_compliance_officer
    permission deactivate = compliance_officer.chief_compliance_officer
    permission delete = compliance_officer.chief_compliance_officer
}

// ============================================================================
// TRANSACTION MONITORING ENTITY
// Represents transaction monitoring rules
// ============================================================================
entity transaction_monitoring {
    // Relations
    relation compliance_officer @compliance_officer
    relation operator @user
    relation reviewer @user
    relation organization @organization
    
    // Permissions
    permission view = operator or reviewer or compliance_officer.chief_compliance_officer or compliance_officer.senior_officer or compliance_officer.officer or organization.admin
    permission configure = compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission enable = compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission disable = compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission view_alerts = operator or reviewer or compliance_officer.officer or compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission acknowledge_alerts = operator or compliance_officer.officer or compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
}

