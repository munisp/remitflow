// Permify Authorization Schema for Compliance and Regulatory Management
// Version: 1.0.0
// This schema defines compliance-related entities and permissions

// ============================================================================
// COMPLIANCE OFFICER ENTITY
// Represents compliance officers
// ============================================================================
entity compliance_officer {
    // Relations
    relation chief_compliance_officer @user
    relation senior_officer @user
    relation officer @user
    relation analyst @user
    
    // Permissions
    permission manage_all = chief_compliance_officer
    permission manage_cases = chief_compliance_officer or senior_officer
    permission review_cases = chief_compliance_officer or senior_officer or officer
    permission investigate = chief_compliance_officer or senior_officer or officer or analyst
    permission approve_kyc = chief_compliance_officer or senior_officer or officer
    permission reject_kyc = chief_compliance_officer or senior_officer or officer
}

// ============================================================================
// AML CASE ENTITY
// Represents Anti-Money Laundering cases
// ============================================================================
entity aml_case {
    // Relations
    relation compliance_officer @compliance_officer
    relation investigator @user
    relation reviewer @user
    relation approver @user
    relation organization @organization
    relation subject @user
    
    // Permissions
    permission view = investigator or reviewer or approver or compliance_officer.chief_compliance_officer or compliance_officer.senior_officer or compliance_officer.officer or organization.admin
    permission investigate = investigator or compliance_officer.chief_compliance_officer or compliance_officer.senior_officer or compliance_officer.officer
    permission update = investigator or reviewer or compliance_officer.chief_compliance_officer or compliance_officer.senior_officer or compliance_officer.officer
    permission escalate = investigator or reviewer or compliance_officer.senior_officer or compliance_officer.officer
    permission approve = approver or compliance_officer.chief_compliance_officer or compliance_officer.senior_officer
    permission reject = approver or compliance_officer.chief_compliance_officer or compliance_officer.senior_officer
    permission close = approver or compliance_officer.chief_compliance_officer
    permission file_sar = compliance_officer.chief_compliance_officer or compliance_officer.senior_officer
}

// ============================================================================
// SAR ENTITY (Suspicious Activity Report)
// Represents Suspicious Activity Reports
// ============================================================================
entity sar {
    // Relations
    relation compliance_officer @compliance_officer
    relation creator @user
    relation reviewer @user
    relation approver @user
    relation organization @organization
    
    // Permissions
    permission view = creator or reviewer or approver or compliance_officer.chief_compliance_officer or compliance_officer.senior_officer or organization.admin
    permission create = compliance_officer.chief_compliance_officer or compliance_officer.senior_officer or compliance_officer.officer
    permission edit = creator or compliance_officer.chief_compliance_officer or compliance_officer.senior_officer
    permission review = reviewer or compliance_officer.chief_compliance_officer or compliance_officer.senior_officer
    permission approve = approver or compliance_officer.chief_compliance_officer
    permission submit = compliance_officer.chief_compliance_officer
    permission delete = compliance_officer.chief_compliance_officer
}

// ============================================================================
// CTR ENTITY (Currency Transaction Report)
// Represents Currency Transaction Reports
// ============================================================================
entity ctr {
    // Relations
    relation compliance_officer @compliance_officer
    relation creator @user
    relation reviewer @user
    relation approver @user
    relation organization @organization
    
    // Permissions
    permission view = creator or reviewer or approver or compliance_officer.chief_compliance_officer or compliance_officer.senior_officer or organization.admin
    permission create = compliance_officer.officer or compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission edit = creator or compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission review = reviewer or compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission approve = approver or compliance_officer.chief_compliance_officer
    permission submit = compliance_officer.chief_compliance_officer
}

