    permission review = reviewer or compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission approve = compliance_officer.senior_officer or compliance_officer.chief_compliance_officer
    permission override = compliance_officer.chief_compliance_officer
}

