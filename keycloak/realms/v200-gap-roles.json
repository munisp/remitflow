{
  "realm": "remitflow",
  "roles": {
    "realm": [
      {
        "name": "immigrant_worker_sender",
        "description": "Immigrant worker with simplified KYC — can send up to USD 500/month via cash-in agent network",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "kyc_tier": ["tier1"],
          "monthly_limit_usd": ["500"],
          "allowed_corridors": ["TG", "NE", "ML", "BJ", "GH"]
        }
      },
      {
        "name": "hnw_client",
        "description": "High Net Worth client — access to negotiated FX spreads, rate locks, and private banking dashboard",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "kyc_tier": ["tier3"],
          "min_aum_ngn": ["50000000"],
          "allowed_corridors": ["UK", "US", "CA", "AU", "IN", "AE", "TG", "GH", "CN"]
        }
      },
      {
        "name": "hnw_rm",
        "description": "HNW Relationship Manager — can manage HNW client portfolios, approve rate locks, and assign RM",
        "composite": true,
        "composites": {
          "realm": ["hnw_client"]
        },
        "clientRole": false,
        "attributes": {
          "can_approve_rate_locks": ["true"],
          "can_view_all_hnw_clients": ["true"],
          "can_set_negotiated_spread": ["true"]
        }
      },
      {
        "name": "sme_trade_user",
        "description": "SME trade payment user — can submit bulk payment batches, Form M, and trade corridor payments",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "kyc_tier": ["tier2"],
          "max_batch_size": ["500"],
          "allowed_corridors": ["CN", "AE", "IN", "UK", "US"],
          "form_m_required_threshold_usd": ["10000"]
        }
      },
      {
        "name": "correspondent_bank_admin",
        "description": "Correspondent bank administrator — can manage nostro/vostro accounts, clearing lines, and settlement",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "can_manage_nostro": ["true"],
          "can_approve_clearing_lines": ["true"],
          "can_view_settlement_reports": ["true"]
        }
      },
      {
        "name": "diaspora_usa",
        "description": "Nigerian diaspora in the USA — access to USA-specific remittance offers, ACH/Zelle integration",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "home_corridor": ["US"],
          "preferred_payment_rails": ["ACH", "Zelle", "wire"],
          "diaspora_region": ["north_america"]
        }
      },
      {
        "name": "diaspora_eu",
        "description": "Nigerian diaspora in EU (Italy, Germany, France, Spain) — access to SEPA and EU-specific offers",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "home_corridor": ["IT", "DE", "FR", "ES"],
          "preferred_payment_rails": ["SEPA", "SEPA_INSTANT"],
          "diaspora_region": ["europe"]
        }
      },
      {
        "name": "diaspora_canada",
        "description": "Nigerian diaspora in Canada — access to Interac e-Transfer and CAD corridor offers",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "home_corridor": ["CA"],
          "preferred_payment_rails": ["Interac", "wire"],
          "diaspora_region": ["north_america"]
        }
      },
      {
        "name": "west_africa_sender",
        "description": "Sender to West African XOF zone (Togo, Niger, Mali, Benin, Ghana) — Mojaloop-settled transfers",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "allowed_corridors": ["TG", "NE", "ML", "BJ", "GH"],
          "settlement_rail": ["mojaloop", "xof_rtgs"],
          "max_single_txn_usd": ["5000"]
        }
      }
    ],
    "client": {
      "remitflow-app": [
        {
          "name": "view:hnw_dashboard",
          "description": "View HNW private banking dashboard"
        },
        {
          "name": "view:correspondent_admin",
          "description": "View correspondent bank admin panel"
        },
        {
          "name": "view:sme_trade",
          "description": "View SME trade payment module"
        },
        {
          "name": "view:west_africa_corridors",
          "description": "View West African corridor send pages"
        },
        {
          "name": "view:diaspora_offers",
          "description": "View diaspora-specific acquisition offers"
        },
        {
          "name": "action:submit_bulk_batch",
          "description": "Submit SME bulk payment batch"
        },
        {
          "name": "action:lock_fx_rate",
          "description": "Lock FX rate for HNW transfer"
        },
        {
          "name": "action:manage_correspondents",
          "description": "Create/edit correspondent bank records"
        }
      ]
    }
  },
  "scopeMappings": [
    {
      "client": "remitflow-app",
      "roles": ["immigrant_worker_sender", "hnw_client", "hnw_rm", "sme_trade_user", "correspondent_bank_admin", "diaspora_usa", "diaspora_eu", "diaspora_canada", "west_africa_sender"]
    }
  ],
  "clientScopeMappings": {
    "remitflow-app": [
      {
        "client": "remitflow-app",
        "roles": ["view:hnw_dashboard", "view:correspondent_admin", "view:sme_trade", "view:west_africa_corridors", "view:diaspora_offers", "action:submit_bulk_batch", "action:lock_fx_rate", "action:manage_correspondents"]
      }
    ]
  }
}
