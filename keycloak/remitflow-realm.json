{
  "realm": "remitflow",
  "displayName": "RemitFlow",
  "displayNameHtml": "<strong>RemitFlow</strong>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "remitflow-app",
      "name": "RemitFlow Web App",
      "description": "RemitFlow cross-border remittance platform",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/oauth/callback",
        "https://*.manus.computer/api/oauth/callback",
        "https://*.manus.space/api/oauth/callback",
        "https://remitflow.app/api/oauth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://*.manus.computer",
        "https://*.manus.space",
        "https://remitflow.app"
      ],
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard RemitFlow user"
      },
      {
        "name": "admin",
        "description": "RemitFlow platform administrator"
      },
      {
        "name": "compliance",
        "description": "Compliance officer with read access to audit logs"
      }
    ]
  },
  "defaultRoles": ["user"],
  "users": [
    {
      "username": "demo",
      "email": "demo@remitflow.app",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo1234",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "admin",
      "email": "admin@remitflow.app",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin1234",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "admin"]
    }
  ],
  "smtpServer": {},
  "loginTheme": "keycloak",
  "accountTheme": "keycloak.v3",
  "adminTheme": "keycloak.v2",
  "emailTheme": "keycloak",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "fr", "es", "ar", "zh-CN"],
  "defaultLocale": "en",
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true
}
