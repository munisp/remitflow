{
  "name": "remitflow",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "styles:build": "tailwindcss -c uis/pwa/tailwind.config.cjs -i uis/pwa/src/styles.source.css -o uis/pwa/src/index.css",
    "dev": "pnpm run styles:build && NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "pnpm run styles:build && vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && mkdir -p dist/proto && cp server/proto/remitflow.proto dist/proto/remitflow.proto",
    "start": "NODE_ENV=production node dist/index.js",
    "worker:temporal": "tsx server/temporal/worker.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs",
    "db:push": "pnpm db:migrate",
    "db:seed": "tsx drizzle/seed.ts",
    "db:seed:reset": "tsx drizzle/seed.ts --reset",
    "seed": "node scripts/seed.mjs",
    "seed:reset": "node scripts/seed.mjs --reset",
    "db:seed:canonical": "node scripts/seed-canonical.mjs",
    "lint": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
