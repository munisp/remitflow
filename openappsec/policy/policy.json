{
  "version": "2.0",
  "policies": {
    "default": {
      "mode": "prevent",
      "practices": [
        {
          "name": "RemitFlow-WAF-Practice",
          "type": "WebApplication",
          "webAttacks": {
            "override-mode": "prevent",
            "minimumConfidence": "high",
            "maxBodySizeKb": 10240,
            "maxHeaderSizeBytes": 8192,
            "maxObjectDepth": 40,
            "maxUrlSizeBytes": 32768
          },
          "antiBot": {
            "override-mode": "prevent",
            "injected-sources": [
              "all"
            ],
            "validated-sources": [
              "all"
            ]
          },
          "snortSignatures": {
            "override-mode": "prevent",
            "configmap": []
          }
        }
      ],
      "triggers": [
        {
          "name": "RemitFlow-Log-Trigger",
          "type": "log",
          "log": {
            "verbosity": "standard",
            "logToCloud": false,
            "logToAgent": true,
            "logTo": [
              {
                "type": "syslog",
                "address": "localhost",
                "port": 514,
                "protocol": "udp"
              }
            ]
          }
        }
      ],
      "exceptions": [
        {
          "name": "stripe-webhook-exception",
          "comment": "Stripe webhook uses raw body for HMAC — bypass WAF body inspection",
          "action": "skip",
          "condition": [
            {
              "type": "url",
              "operator": "equals",
              "value": "/api/stripe/webhook"
            }
          ]
        },
        {
          "name": "csp-report-exception",
          "comment": "CSP violation reports may contain blocked-uri patterns that look like attacks",
          "action": "skip",
          "condition": [
            {
              "type": "url",
              "operator": "equals",
              "value": "/api/csp-report"
            }
          ]
        }
      ]
    }
  },
  "assets": [
    {
      "name": "RemitFlow-App",
      "type": "web-api",
      "urls": [
        "http://app:3000/*"
      ],
      "policy": "default"
    }
  ],
  "rulebase": {
    "name": "RemitFlow-Rulebase",
    "practices": [
      {
        "name": "RemitFlow-WAF-Practice",
        "assets": [
          "RemitFlow-App"
        ]
      }
    ]
  }
}
