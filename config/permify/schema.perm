// RemitFlow — Permify RBAC Authorization Schema
// Fine-grained permission model for all platform resources

entity user {}

entity organization {
  relation admin @user
  relation member @user
  relation compliance_officer @user
  relation support_agent @user

  permission manage = admin
  permission view = admin or member or compliance_officer or support_agent
  permission manage_compliance = admin or compliance_officer
  permission manage_support = admin or support_agent
}

entity transaction {
  relation owner @user
  relation reviewer @user

  permission view = owner or reviewer
  permission cancel = owner
  permission refund = reviewer
  permission approve = reviewer
}

entity kyc_record {
  relation subject @user
  relation reviewer @user

  permission view = subject or reviewer
  permission submit = subject
  permission approve = reviewer
  permission reject = reviewer
  permission request_more_info = reviewer
}

entity wallet {
  relation owner @user
  relation auditor @user

  permission view = owner or auditor
  permission deposit = owner
  permission withdraw = owner
  permission freeze = auditor
  permission unfreeze = auditor
}

entity beneficiary {
  relation owner @user

  permission view = owner
  permission create = owner
  permission update = owner
  permission delete = owner
}

entity savings_goal {
  relation owner @user

  permission view = owner
  permission create = owner
  permission update = owner
  permission delete = owner
  permission deposit = owner
  permission withdraw = owner
}

entity investment {
  relation owner @user
  relation manager @user

  permission view = owner or manager
  permission buy = owner
  permission sell = owner
  permission manage = manager
}

entity dispute {
  relation claimant @user
  relation respondent @user
  relation adjudicator @user

  permission view = claimant or respondent or adjudicator
  permission submit = claimant
  permission respond = respondent
  permission resolve = adjudicator
  permission escalate = claimant or adjudicator
}

entity agent_account {
  relation agent @user
  relation supervisor @user

  permission view = agent or supervisor
  permission cash_in = agent
  permission cash_out = agent
  permission manage = supervisor
  permission suspend = supervisor
}

entity pos_terminal {
  relation operator @user
  relation manager @user

  permission view = operator or manager
  permission process_payment = operator
  permission refund = manager
  permission configure = manager
  permission deactivate = manager
}

entity support_ticket {
  relation creator @user
  relation assignee @user
  relation supervisor @user

  permission view = creator or assignee or supervisor
  permission create = creator
  permission update = creator or assignee
  permission close = assignee or supervisor
  permission escalate = assignee or supervisor
  permission delete = supervisor
}

entity api_key {
  relation owner @user
  relation admin @user

  permission view = owner or admin
  permission create = owner
  permission revoke = owner or admin
  permission rotate = owner
}

entity report {
  relation owner @user
  relation compliance_officer @user
  relation admin @user

  permission view = owner or compliance_officer or admin
  permission generate = owner or compliance_officer
  permission export = compliance_officer or admin
  permission delete = admin
}

entity audit_log {
  relation subject @user
  relation auditor @user

  permission view = auditor
  permission export = auditor
}

entity community_fund {
  relation creator @user
  relation member @user
  relation admin @user

  permission view = creator or member or admin
  permission create = creator
  permission contribute = member
  permission withdraw = creator
  permission manage = admin
  permission close = creator or admin
}

entity diaspora_collective {
  relation creator @user
  relation member @user

  permission view = creator or member
  permission create = creator
  permission join = member
  permission leave = member
  permission manage = creator
}

entity market_listing {
  relation seller @user
  relation buyer @user
  relation admin @user

  permission view = seller or buyer or admin
  permission create = seller
  permission update = seller
  permission delete = seller or admin
  permission purchase = buyer
  permission flag = admin
}

entity talent_profile {
  relation owner @user
  relation client @user
  relation admin @user

  permission view = owner or client or admin
  permission create = owner
  permission update = owner
  permission book = client
  permission manage = admin
}
