{
  "title": "RemitFlow — Production Overview",
  "uid": "remitflow-overview",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Transactions per Second",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "rate(remitflow_transactions_total[1m])",
        "legendFormat": "TPS"
      }]
    },
    {
      "id": 2,
      "title": "Transaction Success Rate",
      "type": "gauge",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "1 - (rate(remitflow_transactions_failed_total[5m]) / rate(remitflow_transactions_total[5m]))",
        "legendFormat": "Success Rate"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Active Users",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "remitflow_active_sessions_total",
        "legendFormat": "Active Sessions"
      }]
    },
    {
      "id": 4,
      "title": "High Risk Transactions",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "rate(risk_high_risk_total[5m])",
        "legendFormat": "High Risk/s"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Transaction Volume (USD)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(rate(remitflow_transaction_amount_usd_sum[5m]))",
        "legendFormat": "Volume USD/s"
      }]
    },
    {
      "id": 6,
      "title": "Service Health",
      "type": "table",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "up",
        "legendFormat": "{{ job }}"
      }]
    },
    {
      "id": 7,
      "title": "API Response Time (p99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
        "legendFormat": "p99 {{ job }}"
      }]
    },
    {
      "id": 8,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "kafka_consumer_lag_sum",
        "legendFormat": "{{ topic }}"
      }]
    }
  ]
}
