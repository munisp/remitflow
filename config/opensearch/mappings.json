{
  "indices": {
    "remitflow-transactions": {
      "settings": {
        "number_of_shards": 3,
        "number_of_replicas": 1,
        "analysis": {
          "analyzer": {
            "remitflow_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": ["lowercase", "stop", "snowball"]
            }
          }
        }
      },
      "mappings": {
        "properties": {
          "id": { "type": "keyword" },
          "userId": { "type": "keyword" },
          "amount": { "type": "scaled_float", "scaling_factor": 100 },
          "currency": { "type": "keyword" },
          "status": { "type": "keyword" },
          "type": { "type": "keyword" },
          "destinationCountry": { "type": "keyword" },
          "sourceCountry": { "type": "keyword" },
          "beneficiaryName": {
            "type": "text",
            "analyzer": "remitflow_analyzer",
            "fields": { "keyword": { "type": "keyword" } }
          },
          "reference": { "type": "keyword" },
          "note": { "type": "text", "analyzer": "remitflow_analyzer" },
          "createdAt": { "type": "date" },
          "updatedAt": { "type": "date" },
          "riskScore": { "type": "float" },
          "riskLevel": { "type": "keyword" }
        }
      }
    },
    "remitflow-users": {
      "settings": {
        "number_of_shards": 2,
        "number_of_replicas": 1
      },
      "mappings": {
        "properties": {
          "id": { "type": "keyword" },
          "email": { "type": "keyword" },
          "name": {
            "type": "text",
            "analyzer": "standard",
            "fields": { "keyword": { "type": "keyword" } }
          },
          "phone": { "type": "keyword" },
          "country": { "type": "keyword" },
          "kycStatus": { "type": "keyword" },
          "kycTier": { "type": "integer" },
          "role": { "type": "keyword" },
          "createdAt": { "type": "date" }
        }
      }
    },
    "remitflow-beneficiaries": {
      "settings": {
        "number_of_shards": 2,
        "number_of_replicas": 1
      },
      "mappings": {
        "properties": {
          "id": { "type": "keyword" },
          "userId": { "type": "keyword" },
          "name": {
            "type": "text",
            "analyzer": "standard",
            "fields": { "keyword": { "type": "keyword" } }
          },
          "accountNumber": { "type": "keyword" },
          "bankName": {
            "type": "text",
            "fields": { "keyword": { "type": "keyword" } }
          },
          "country": { "type": "keyword" },
          "currency": { "type": "keyword" },
          "createdAt": { "type": "date" }
        }
      }
    },
    "remitflow-audit-logs": {
      "settings": {
        "number_of_shards": 3,
        "number_of_replicas": 1
      },
      "mappings": {
        "properties": {
          "id": { "type": "keyword" },
          "userId": { "type": "keyword" },
          "action": { "type": "keyword" },
          "resource": { "type": "keyword" },
          "resourceId": { "type": "keyword" },
          "details": { "type": "text" },
          "ipAddress": { "type": "ip" },
          "userAgent": { "type": "text" },
          "severity": { "type": "keyword" },
          "createdAt": { "type": "date" }
        }
      }
    },
    "remitflow-market-listings": {
      "settings": {
        "number_of_shards": 2,
        "number_of_replicas": 1
      },
      "mappings": {
        "properties": {
          "id": { "type": "keyword" },
          "sellerId": { "type": "keyword" },
          "title": {
            "type": "text",
            "analyzer": "remitflow_analyzer",
            "fields": { "keyword": { "type": "keyword" } }
          },
          "description": { "type": "text", "analyzer": "remitflow_analyzer" },
          "category": { "type": "keyword" },
          "price": { "type": "scaled_float", "scaling_factor": 100 },
          "currency": { "type": "keyword" },
          "country": { "type": "keyword" },
          "status": { "type": "keyword" },
          "tags": { "type": "keyword" },
          "createdAt": { "type": "date" }
        }
      }
    }
  }
