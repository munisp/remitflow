                "routing_rules": [
                    "/api/v1/pix/* \u2192 PIX Gateway",
                    "/api/v1/rates \u2192 BRL Liquidity",
                    "/api/v1/transfers \u2192 Integration Orchestrator",
                    "/* \u2192 Enhanced API Gateway"
