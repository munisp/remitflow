# Savings Service Configuration
SERVICE_NAME=savings-service
SERVICE_PORT=8012

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/savings_db

# Redis
REDIS_URL=redis://localhost:6379/7

# Interest Rates (Annual %)
FLEXIBLE_INTEREST_RATE=4.0
LOCKED_30_INTEREST_RATE=8.0
LOCKED_90_INTEREST_RATE=12.0
GOAL_INTEREST_RATE=6.0

# Limits
MIN_SAVINGS_AMOUNT=100.00
MAX_SAVINGS_AMOUNT=100000000.00

# Auto-Save
AUTO_SAVE_EXECUTION_HOUR=6
AUTO_SAVE_RETRY_COUNT=3

# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256

# Service URLs
WALLET_SERVICE_URL=http://wallet-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8007
