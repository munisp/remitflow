# Fastfile - Remittance Platform Mobile CI/CD Pipeline
# Production-grade build, test, and deployment automation

default_platform(:ios)

# Environment variables
ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"
ENV["FASTLANE_HIDE_CHANGELOG"] = "1"

# Shared configuration
BUNDLE_ID = "com.remittance.app"
TEAM_ID = ENV["APPLE_TEAM_ID"]
APP_STORE_CONNECT_API_KEY_ID = ENV["APP_STORE_CONNECT_API_KEY_ID"]
APP_STORE_CONNECT_ISSUER_ID = ENV["APP_STORE_CONNECT_ISSUER_ID"]

# ============================================
# iOS Platform
# ============================================

platform :ios do
  
  desc "Setup iOS development environment"
  lane :setup do
    setup_ci if is_ci
    
    # Install CocoaPods dependencies
    cocoapods(
      podfile: "./ios/AgentBanking/Podfile",
      use_bundle_exec: true,
      try_repo_update_on_error: true
    )
    
    # Setup code signing
    match(
      type: "development",
      app_identifier: BUNDLE_ID,
      readonly: is_ci
    )
  end

  desc "Run iOS unit tests"
  lane :test do
    scan(
      workspace: "./ios/AgentBanking/AgentBanking.xcworkspace",
      scheme: "AgentBanking",
      devices: ["iPhone 15 Pro"],
      code_coverage: true,
      output_directory: "./test_output",
      output_types: "html,junit",
      fail_build: true
    )
  end

  desc "Build iOS app for development"
  lane :build_dev do
    setup
    
    gym(
      workspace: "./ios/AgentBanking/AgentBanking.xcworkspace",
      scheme: "AgentBanking",
      configuration: "Debug",
      export_method: "development",
      output_directory: "./build",
      output_name: "AgentBanking-Dev.ipa"
    )
  end

  desc "Build iOS app for staging"
  lane :build_staging do
    setup
    
    # Use staging code signing
    match(
      type: "adhoc",
      app_identifier: "#{BUNDLE_ID}.staging",
      readonly: is_ci
    )
    
    gym(
      workspace: "./ios/AgentBanking/AgentBanking.xcworkspace",
      scheme: "AgentBanking",
      configuration: "Staging",
      export_method: "ad-hoc",
      output_directory: "./build",
      output_name: "AgentBanking-Staging.ipa"
    )
  end

  desc "Build iOS app for production"
  lane :build_production do
    setup
    
    # Use App Store code signing
    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      readonly: is_ci
    )
    
    # Increment build number
    increment_build_number(
      build_number: ENV["BUILD_NUMBER"] || latest_testflight_build_number + 1
    )
    
    gym(
      workspace: "./ios/AgentBanking/AgentBanking.xcworkspace",
      scheme: "AgentBanking",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "AgentBanking.ipa",
      include_bitcode: false,
      include_symbols: true
    )
  end

  desc "Deploy to TestFlight"
  lane :deploy_testflight do
    build_production
    
    # Upload to TestFlight
    pilot(
      ipa: "./build/AgentBanking.ipa",
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false,
      changelog: changelog_from_git_commits(
        commits_count: 10,
        pretty: "- %s"
      )
    )
    
    # Upload dSYMs to Sentry
    sentry_upload_dsym(
      org_slug: "remittance",
      project_slug: "ios-app",
      dsym_path: "./build/AgentBanking.app.dSYM.zip"
    )
    
    # Notify team
    slack(
      message: "iOS build uploaded to TestFlight!",
      success: true,
      slack_url: ENV["SLACK_WEBHOOK_URL"]
    ) if ENV["SLACK_WEBHOOK_URL"]
  end

  desc "Deploy to App Store"
  lane :deploy_appstore do
    build_production
    
    # Upload to App Store Connect
    deliver(
      ipa: "./build/AgentBanking.ipa",
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: false,
      precheck_include_in_app_purchases: false
    )
    
    # Upload dSYMs to Sentry
    sentry_upload_dsym(
      org_slug: "remittance",
      project_slug: "ios-app",
      dsym_path: "./build/AgentBanking.app.dSYM.zip"
    )
    
    # Notify team
    slack(
      message: "iOS build submitted to App Store!",
      success: true,
      slack_url: ENV["SLACK_WEBHOOK_URL"]
    ) if ENV["SLACK_WEBHOOK_URL"]
  end

  desc "Run security scan"
  lane :security_scan do
    # Run MobSF security scan
    sh("mobsf --scan ./build/AgentBanking.ipa --output ./security_report_ios.json") rescue nil
    
    # Check for hardcoded secrets
    sh("gitleaks detect --source . --report-path ./gitleaks_ios.json") rescue nil
  end

  # Error handling
  error do |lane, exception|
    slack(
      message: "iOS #{lane} failed: #{exception.message}",
      success: false,
      slack_url: ENV["SLACK_WEBHOOK_URL"]
    ) if ENV["SLACK_WEBHOOK_URL"]
  end
end

# ============================================
# Android Platform
# ============================================

platform :android do
  
  desc "Setup Android development environment"
  lane :setup do
    # Ensure Gradle wrapper is executable
    sh("chmod +x ../android/gradlew")
  end

  desc "Run Android unit tests"
  lane :test do
    gradle(
      project_dir: "./android",
      task: "testProductionDebugUnitTest",
      flags: "--stacktrace"
    )
  end

  desc "Run Android instrumented tests"
  lane :instrumented_test do
    gradle(
      project_dir: "./android",
      task: "connectedProductionDebugAndroidTest",
      flags: "--stacktrace"
    )
  end

  desc "Build Android app for development"
  lane :build_dev do
    setup
    
    gradle(
      project_dir: "./android",
      task: "assembleProductionDebug",
      flags: "--stacktrace"
    )
  end

  desc "Build Android app for staging"
  lane :build_staging do
    setup
    
    gradle(
      project_dir: "./android",
      task: "assembleStagingRelease",
      flags: "--stacktrace",
      properties: {
        "android.injected.signing.store.file" => ENV["KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"]
      }
    )
  end

  desc "Build Android app for production"
  lane :build_production do
    setup
    
    # Increment version code
    android_set_version_code(
      version_code: ENV["BUILD_NUMBER"] || (android_get_version_code.to_i + 1).to_s,
      gradle_file: "./android/app/build.gradle.kts"
    )
    
    gradle(
      project_dir: "./android",
      task: "bundleProductionRelease",
      flags: "--stacktrace",
      properties: {
        "android.injected.signing.store.file" => ENV["KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"]
      }
    )
  end

  desc "Deploy to Google Play Internal Testing"
  lane :deploy_internal do
    build_production
    
    upload_to_play_store(
      track: "internal",
      aab: "./android/app/build/outputs/bundle/productionRelease/app-production-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft"
    )
    
    # Upload ProGuard mapping to Sentry
    sentry_upload_proguard(
      org_slug: "remittance",
      project_slug: "android-app",
      android_manifest_path: "./android/app/src/main/AndroidManifest.xml",
      mapping_path: "./android/app/build/outputs/mapping/productionRelease/mapping.txt"
    )
    
    # Notify team
    slack(
      message: "Android build uploaded to Play Store Internal Testing!",
      success: true,
      slack_url: ENV["SLACK_WEBHOOK_URL"]
    ) if ENV["SLACK_WEBHOOK_URL"]
  end

  desc "Deploy to Google Play Production"
  lane :deploy_production do
    build_production
    
    upload_to_play_store(
      track: "production",
      aab: "./android/app/build/outputs/bundle/productionRelease/app-production-release.aab",
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed",
      rollout: "0.1" # 10% rollout
    )
    
    # Upload ProGuard mapping to Sentry
    sentry_upload_proguard(
      org_slug: "remittance",
      project_slug: "android-app",
      android_manifest_path: "./android/app/src/main/AndroidManifest.xml",
      mapping_path: "./android/app/build/outputs/mapping/productionRelease/mapping.txt"
    )
    
    # Notify team
    slack(
      message: "Android build released to Play Store (10% rollout)!",
      success: true,
      slack_url: ENV["SLACK_WEBHOOK_URL"]
    ) if ENV["SLACK_WEBHOOK_URL"]
  end

  desc "Run security scan"
  lane :security_scan do
    # Run MobSF security scan
    sh("mobsf --scan ./android/app/build/outputs/apk/production/release/app-production-release.apk --output ./security_report_android.json") rescue nil
    
    # Check for hardcoded secrets
    sh("gitleaks detect --source . --report-path ./gitleaks_android.json") rescue nil
  end

  # Error handling
  error do |lane, exception|
    slack(
      message: "Android #{lane} failed: #{exception.message}",
      success: false,
      slack_url: ENV["SLACK_WEBHOOK_URL"]
    ) if ENV["SLACK_WEBHOOK_URL"]
  end
end

# ============================================
# Cross-Platform Lanes
# ============================================

desc "Run all tests"
lane :test_all do
  ios test
  android test
end

desc "Build all platforms for staging"
lane :build_staging_all do
  ios build_staging
  android build_staging
end

desc "Build all platforms for production"
lane :build_production_all do
  ios build_production
  android build_production
end

desc "Deploy all platforms to beta"
lane :deploy_beta_all do
  ios deploy_testflight
  android deploy_internal
end

desc "Run security scans on all platforms"
lane :security_scan_all do
  ios security_scan
  android security_scan
end

desc "Generate release notes from git commits"
lane :release_notes do
  changelog_from_git_commits(
    commits_count: 20,
    pretty: "- %s (%h)",
    date_format: "short",
    match_lightweight_tag: false,
    merge_commit_filtering: "exclude_merges"
  )
end
