# ============================================================================
# RemitFlow Platform — Environment Variables Reference
# Copy this file to .env and fill in all REQUIRED values before starting.
# NEVER commit .env to version control.
# Run: python3 backend/scripts/generate_secrets.py to generate secure values.
# ============================================================================

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

JWT_SECRET_KEY=
ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ALLOWED_ORIGINS=https://app.remitflow.com,https://admin.remitflow.com
CORS_ALLOW_CREDENTIALS=true

DATABASE_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

REDIS_URL=

KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SASL_USERNAME=remittance
KAFKA_SASL_PASSWORD=

TEMPORAL_HOST=temporal-frontend:7233
TEMPORAL_NAMESPACE=remitflow-prod

VAULT_ENABLED=true
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_PKI_PATH=pki
VAULT_ROLE=remitflow-backend

WISE_API_KEY=
WISE_PROFILE_ID=
WISE_WEBHOOK_SECRET=

REMITLY_API_KEY=
REMITLY_WEBHOOK_SECRET=

STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
INFURA_PROJECT_ID=
ALCHEMY_API_KEY=

NIBSS_API_KEY=
NIBSS_SECRET_KEY=
NIBSS_API_URL=https://api.nibss-plc.com.ng
INTERSWITCH_CLIENT_ID=
INTERSWITCH_CLIENT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@remitflow.com
SENDGRID_FROM_NAME=RemitFlow

FIREBASE_SERVER_KEY=
FIREBASE_PROJECT_ID=

AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=

SMILE_ID_API_KEY=
SMILE_ID_PARTNER_ID=

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_RETENTION_DAYS=30

MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true

RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

AML_CTR_THRESHOLD=10000
AML_SAR_THRESHOLD=5000
AML_STRUCTURING_WINDOW_H=24
AML_STRUCTURING_COUNT=3
AML_VELOCITY_WINDOW_H=1
AML_VELOCITY_AMOUNT=20000

IDEMPOTENCY_TTL_SECONDS=86400

FRAUD_ENGINE_URL=http://fraud-detection:8016
SMART_ROUTING_URL=http://api:8000/smart-routing
