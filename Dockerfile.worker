# ============================================================================
# RemitFlow — Temporal Worker Dockerfile
# Multi-stage build: builder → production
# Runs the Temporal workflow worker independently from the Express server.
# ============================================================================

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package manifests and install ALL deps (including devDeps for tsc)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source
COPY tsconfig.json ./
COPY server ./server
COPY drizzle ./drizzle
COPY shared ./shared

# Compile TypeScript
RUN pnpm exec tsc --project tsconfig.json --outDir dist --declaration false \
    || pnpm exec tsc --project tsconfig.json --outDir dist --skipLibCheck --declaration false

# ── Stage 2: Production ───────────────────────────────────────────────────────
FROM node:22-alpine AS production

WORKDIR /app

# Create non-root user
RUN addgroup -S remitflow && adduser -S worker -G remitflow

# Install pnpm (production only)
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package manifests and install ONLY production deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod

# Copy compiled output from builder
COPY --from=builder /app/dist ./dist

# Copy drizzle schema (needed at runtime for migrations)
COPY drizzle ./drizzle

# Set ownership
RUN chown -R worker:remitflow /app

USER worker

# ── Health check ──────────────────────────────────────────────────────────────
# The worker exposes a simple HTTP health endpoint on port 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1

# ── Environment ───────────────────────────────────────────────────────────────
ENV NODE_ENV=production
ENV TEMPORAL_ADDRESS=temporal:7233
ENV TEMPORAL_NAMESPACE=remitflow
ENV TEMPORAL_TASK_QUEUE=remitflow-transfers
ENV WORKER_HEALTH_PORT=8080

# ── Entrypoint ────────────────────────────────────────────────────────────────
EXPOSE 8080
CMD ["node", "dist/server/temporal/worker.js"]
