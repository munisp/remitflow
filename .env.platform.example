# Copy to .env and supply deployment-managed secrets before starting the platform.
# Do not commit the populated .env file. All blank values are required secrets.

POSTGRES_DB=remitflow
POSTGRES_USER=remitflow
POSTGRES_PASSWORD=
REDIS_PASSWORD=

KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=remitflow
KEYCLOAK_CLIENT_ID=remitflow-backend
KEYCLOAK_CLIENT_SECRET=

PERMIFY_TENANT_ID=remitflow
PERMIFY_HTTP_URL=http://permify:3476

APISIX_ADMIN_KEY=
APISIX_HTTP_PORT=9080
APISIX_HTTPS_PORT=9443
APISIX_GATEWAY_URL=http://apisix:9080
APISIX_UPSTREAM_API=api:3000
APISIX_UPSTREAM_LAKEHOUSE=lakehouse:8102
JWT_SECRET=

OPENSEARCH_USER=remitflow
OPENSEARCH_PASSWORD=

S3_ACCESS_KEY=
S3_SECRET_KEY=
LAKEHOUSE_BUCKET=remitflow-lakehouse
LAKEHOUSE_CATALOG=remitflow
LAKEHOUSE_WAREHOUSE=s3://remitflow-lakehouse/

TIGERBEETLE_CLUSTER_ID=0
FLUVIO_PROFILE=remitflow

DAPR_STATE_STORE=statestore
DAPR_PUBSUB=pubsub
DAPR_SECRET_STORE=secretstore

TEMPORAL_NAMESPACE=default
KAFKA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=remitflow

# OpenAppSec local policy management endpoint; token is optional for local policy mode.
OPENAPPSEC_MGMT_URL=http://appsec-agent:4000
OPENAPPSEC_TOKEN=

AML_MODEL_MIN_TRAINING_ROWS=200
AML_MODEL_TRAINING_TOKEN=
AML_THRESHOLD_MEDIUM=31
AML_THRESHOLD_HIGH=61
AML_THRESHOLD_CRITICAL=81

# Mojaloop is optional and only required for routes that use Mojaloop directly.
MOJALOOP_HUB_URL=
MOJALOOP_FSP_ID=
MOJALOOP_ILP_SECRET=

# Internal service-discovery values for the canonical Compose network.
# Override these only when deploying the services under different DNS names or ports.
REDIS_URL=redis://:replace-with-REDIS_PASSWORD@redis:6379/0
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_ADMIN=replace-with-KEYCLOAK_ADMIN_USERNAME
PERMIFY_ENDPOINT=permify:3478
TIGERBEETLE_ADDRESSES=tigerbeetle:3000
TIGERBEETLE_BRIDGE_URL=http://tigerbeetle-bridge:8117
FLUVIO_ENDPOINT=fluvio-sc:9003
LAKEHOUSE_URL=http://lakehouse:8102
OPENSEARCH_URL=http://opensearch:9200
APISIX_ADMIN_URL=http://apisix:9180
DAPR_HOST=127.0.0.1
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_APP_ID=remitflow-api
TEMPORAL_ADDRESS=temporal:7233

# Live FX health endpoint and SMS delivery configuration.
FX_HEALTH_URL=
SMS_PROVIDER=africas_talking
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional specialized rail adapters. Leave blank to disable that rail; calls will
# fail explicitly instead of returning a simulated payment result.
BRICSPAY_SERVICE_URL=
MBRIDGE_SERVICE_URL=
GHIPSS_SERVICE_URL=
AFRICBDC_SERVICE_URL=
PAPSS_SERVICE_URL=

# Mandatory real REST backend used by the canonical PWA compatibility proxy.
# This must be a routable HTTP(S) core-banking service, never the RemitFlow API itself.
CORE_BANKING_UPSTREAM_URL=

# Durable regulatory filing worker. These operational controls are required.
REGULATORY_FILING_MAX_ATTEMPTS=8
REGULATORY_FILING_BACKOFF_MS=30000
REGULATORY_FILING_HTTP_TIMEOUT_MS=20000
REGULATORY_FILING_LOCK_SECONDS=120
REGULATORY_FILING_BATCH_SIZE=25
REGULATORY_FILING_RETRY_INTERVAL_MS=30000

# Configure only the regulator connectors authorized for each deployed entity.
# A filing for an unconfigured jurisdiction is retained in the dead-letter queue,
# never marked as submitted or silently discarded.
NFIU_API_URL=
NFIU_API_KEY=
FINTRAC_API_URL=
FINTRAC_API_KEY=
FINCEN_API_URL=
FINCEN_API_KEY=
NCA_API_URL=
NCA_API_KEY=

# Durable PostgreSQL idempotency for authenticated financial mutations.
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_SECONDS=120

# Optional private or approved MapLibre style endpoint for the admin Operations Map.
# Leave blank to render the authorised corridor table without loading third-party map tiles.
VITE_MAP_STYLE_URL=
