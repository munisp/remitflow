# Environment variables consumed by the scripts in infrastructure/.
# Copy to infrastructure/.env, fill in real values, and `source infrastructure/.env`
# before running 00_provision_chart.sh / generate-pos-charts.sh / 02_setup_docker_registry_auth.sh.
#
# Never commit a filled-in copy of this file — infrastructure/.env is gitignored.

# ═══ DATABASE (REQUIRED) ═══
# DigitalOcean managed Postgres used by generated Helm chart `secrets:` blocks.
DB_HOST=
DB_PORT=25060
DB_USER=doadmin
DB_PASSWORD=
DB_NAME=link_core_banking

# ═══ REDIS (REQUIRED for generate-pos-charts.sh) ═══
REDIS_HOST=redis-master.redis.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ═══ CONTAINER REGISTRY (REQUIRED for 02_setup_docker_registry_auth.sh) ═══
# A DigitalOcean Container Registry API token (used as both username and
# password per DO's docker-config convention). Generate with:
#   doctl registry docker-config --read-write
# or from the DO control panel under API > Tokens.
DO_REGISTRY_TOKEN=
