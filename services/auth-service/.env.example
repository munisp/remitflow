# Copy to .env for local development. In-cluster, these are injected via the
# Helm chart's `secrets:` block (see infrastructure/charts/auth-service).

DATABASE_URI=postgresql://doadmin:password@localhost:25060/link_core_banking
AUDIT_SVC_URL=http://audit-service:8000
DAPR_PUBSUB_NAME=pubsub
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
INTERNAL_API_BASE_URL=http://localhost

# Keycloak
KEYCLOAK_BASE_URL=https://keycloak.54remit.upi.dev
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
DEFAULT_KEYCLOAK_REALM=54remit
DEFAULT_KEYCLOAK_PUBLIC_KEY=
DEFAULT_TENANT_ID=54remit

# Superadmin bootstrap (only needed once, via POST /system/seed/admin)
SYSTEM_SEED_TOKEN=
DEFAULT_SUPER_ADMIN_NAME=
DEFAULT_SUPER_ADMIN_EMAIL=
DEFAULT_SUPER_ADMIN_PASSWORD=

# Permify (ReBAC authorization)
PERMIFY_URL=http://localhost:3476
PERMIFY_DEFAULT_TENANT=54remit
PERMIFY_WRITE_ATTEMPTS=15

# VPN/Tor/datacenter login blocking
BLOCK_VPN=true
BLOCK_TOR=true
BLOCK_DATACENTER=false

# OTP (Redis-backed)
REDIS_URL=redis://localhost:6379/0

APP_ENV=development
ROOT_PATH=/
