# Copy to .env for local development. In-cluster, these are injected via the
# Helm chart's `secrets:` block (see infrastructure/charts/tenant-management).

NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=80
LOG_PATH=./logs
LOG_LEVEL=info
LOG_SILENT=false
DATABASE_URI=postgresql://doadmin:password@localhost:25060/link_core_banking
# DAPR_HOST / DAPR_HTTP_PORT are auto-injected by the Dapr sidecar in-cluster;
# only needed here for local (non-Dapr) development.
DAPR_HOST=127.0.0.1
DAPR_HTTP_PORT=3500
# Optional — leave unset until a billing-service exists in this platform.
BILLING_SERVICE_URL=
