# ══════════════════════════════════════════════════════════════════════════════
# RemitFlow — Environment Variables Reference
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# All secrets should be stored in a secrets manager (Vault, AWS Secrets Manager)
# in production.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
LOG_LEVEL=info

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://remitflow:remitflow@localhost:5432/remitflow
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_READ_REPLICA_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
# ACL-enforced (see redis/users.acl). The app connects as remitflow_app;
# REDIS_APP_PASSWORD must match the password rendered into the ACL file.
# Password inside REDIS_URL must equal REDIS_APP_PASSWORD below (no shell
# expansion happens when this file is loaded — fill in both).
REDIS_URL=redis://remitflow_app:your-redis-app-password@localhost:6379
REDIS_APP_PASSWORD=
REDIS_PASSWORD=
REDIS_TLS=false
# Fail-closed by default: Redis outages surface as errors. Set true ONLY for
# local dev to allow degraded fail-open behaviour (never in production).
ALLOW_REDIS_FAILOPEN=false

# ── Authentication (Keycloak) ─────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=remitflow
KEYCLOAK_CLIENT_ID=remitflow-api
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=your-keycloak-admin-secret
# Expected JWT audience for bearer verification (defaults to KEYCLOAK_CLIENT_ID).
KEYCLOAK_AUDIENCE=remitflow-api
# OIDC discovery document URL for JWKS verification.
KEYCLOAK_DISCOVERY_URL=http://localhost:8080/realms/remitflow/.well-known/openid-configuration
# Session cookie TTL in ms; aligns with the 300s realm access-token lifespan.
KEYCLOAK_SESSION_TTL_MS=300000
# Comma-separated allowed redirect URIs for the provisioned Keycloak client.
# NEVER use "*" (wildcard redirect URIs enable open-redirect/token theft).
# When unset, the server derives "<APP_URL>/*" and logs a loud warning.
KEYCLOAK_CLIENT_REDIRECT_URIS=http://localhost:3000/*
# Public base URL of the app; used to derive Keycloak redirect URIs/web origins
# when KEYCLOAK_CLIENT_REDIRECT_URIS is unset.
APP_URL=http://localhost:3000
# Dev-only password grant login endpoint. MUST stay false outside local dev.
ALLOW_DEV_LOGIN=false
JWT_SECRET=your-jwt-secret-min-32-chars-change-this

# ── Authorization (Permify) ───────────────────────────────────────────────────
PERMIFY_URL=http://localhost:3476
PERMIFY_API_KEY=your-permify-api-key
# Canonical tenant for the whole platform.
PERMIFY_TENANT_ID=remitflow
# Canonical authorization schema bootstrapped into the tenant.
PERMIFY_SCHEMA_PATH=infrastructure/integration/permify_policies/remitflow_schema.perm

# ── Message Broker (Kafka) ────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=remitflow-api
KAFKA_GROUP_ID=remitflow-consumers
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TLS=false
# Confluent Schema Registry (compose service schema-registry:8081).
SCHEMA_REGISTRY_URL=http://localhost:8081

# ── Stream Processing (Fluvio) ────────────────────────────────────────────────
FLUVIO_ENDPOINT=localhost:9003
FLUVIO_TLS=false
# HTTP bridge of the Rust fluvio-consumer (compose service fluvio-consumer:8300).
# Empty = publishing fails closed with BRIDGE_NOT_CONFIGURED.
FLUVIO_HTTP_BRIDGE_URL=http://localhost:8300

# ── Workflow Engine (Temporal) ────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=remitflow
TEMPORAL_TASK_QUEUE=remitflow-main
TEMPORAL_TLS_CERT=
TEMPORAL_TLS_KEY=

# ── Sidecar (Dapr) ────────────────────────────────────────────────────────────
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_APP_ID=remitflow-api
# Component names (must match infrastructure/manifests/dapr/*.yaml metadata.name).
DAPR_PUBSUB=pubsub
DAPR_STATE_STORE=statestore

# ── Ledger (TigerBeetle) ─────────────────────────────────────────────────────
# Host port 3002 maps to the tigerbeetle container's 3000 (see docker-compose.yml).
TIGERBEETLE_ADDRESS=localhost:3002
TIGERBEETLE_ADDRESSES=tigerbeetle:3000
TIGERBEETLE_CLUSTER_ID=0
# HTTP gateway of the Rust TigerBeetle bridge (compose service tb-bridge:8200).
TIGERBEETLE_BRIDGE_URL=http://localhost:8200

# ── API Gateway (APISIX) ─────────────────────────────────────────────────────
# Admin API is loopback-only in compose (127.0.0.1:9180).
APISIX_ADMIN_URL=http://localhost:9180
# REQUIRED, no default. Must match the admin key rendered into
# services/gateway-config/apisix.yaml. Generate 32+ hex chars and rotate regularly.
APISIX_ADMIN_KEY=
# Read-only Admin API key (also rendered into apisix.yaml).
APISIX_VIEWER_KEY=
APISIX_GATEWAY_URL=http://localhost:9080
# REQUIRED, no default. etcd root password (INFRA-001): APISIX authenticates to
# etcd with these credentials; rendered into apisix.yaml at container start.
# Existing etcd-data volumes initialized with ALLOW_NONE_AUTHENTICATION=yes must
# be recreated once (docker compose down -v etcd) for auth to take effect.
ETCD_ROOT_PASSWORD=
# REQUIRED, no default. Grafana admin password (INFRA-003) — replaces the old
# hardcoded admin/admin. Grafana is loopback-bound (127.0.0.1:3001).
GF_SECURITY_ADMIN_PASSWORD=
APISIX_API_UPSTREAM_HOST=api:3000
# OIDC plugin hardening for gateway routes.
APISIX_OIDC_BEARER_ONLY=true
APISIX_OIDC_SSL_VERIFY=true
# Push file-defined routes to APISIX on boot (go-apisix-manager). Default off:
# routes are managed dynamically via the Admin API.
APISIX_SYNC_ON_STARTUP=false

# ── WAF (OpenAppSec) ─────────────────────────────────────────────────────────
# REQUIRED by the compose agent (no dev default).
OPENAPPSEC_TOKEN=
OPENAPPSEC_MODE=prevent
# HTTP inspection sidecar URL consumed by server/security.openappsec.ts.
# Empty = middleware is an explicit no-op (requests are NOT inspected).
OPENAPPSEC_SIDECAR_URL=

# ── Search & Analytics (OpenSearch) ──────────────────────────────────────────
# Security plugin is enabled in compose: HTTPS + auth required.
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
# Strong password REQUIRED (also used as OPENSEARCH_INITIAL_ADMIN_PASSWORD).
OPENSEARCH_PASSWORD=
OPENSEARCH_TLS=true
# TLS certificate verification is ON by default. Set true ONLY for local dev
# with self-signed demo certs (refused loudly in production).
OPENSEARCH_INSECURE=false

# ── Payments (Mojaloop) ───────────────────────────────────────────────────────
MOJALOOP_ML_API_URL=http://localhost:4000
MOJALOOP_FSPIOP_SOURCE=remitflow
MOJALOOP_FSPIOP_DESTINATION=
# Internal connector service (compose service mojaloop-connector:8113).
MOJALOOP_URL=http://mojaloop-connector:8113
# Hub/Switch endpoint. Empty = Mojaloop routes FAIL CLOSED (no simulated transfers).
MOJALOOP_HUB_URL=
# JWS signing keys (PEM). Empty = signing disabled; hub calls that require JWS
# fail explicitly instead of sending unsigned requests.
MOJALOOP_JWS_PRIVATE_KEY=
MOJALOOP_JWS_PUBLIC_KEY=

# ── AI / LLM (Ollama — local inference) ──────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_SUPPORT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=llama3.2-vision:11b
OLLAMA_FX_MODEL=mistral:7b
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# ── Open Banking ─────────────────────────────────────────────────────────────
OPEN_BANKING_SVC_URL=http://go-open-banking:8120
OPEN_BANKING_CLIENT_ID=
OPEN_BANKING_CLIENT_SECRET=
OPEN_BANKING_REDIRECT_URI=https://app.remitflow.io/open-banking/callback

# ── Lakehouse (Delta Lake / MinIO) ────────────────────────────────────────────
LAKEHOUSE_S3_ENDPOINT=http://localhost:9000
LAKEHOUSE_S3_ACCESS_KEY=
LAKEHOUSE_S3_SECRET_KEY=
LAKEHOUSE_S3_BUCKET=remitflow-lakehouse
LAKEHOUSE_DELTA_TABLE_PATH=s3://remitflow-lakehouse/delta
# Internal service URLs (compose).
LAKEHOUSE_ETL_URL=http://lakehouse-etl:8089
LAKEHOUSE_URL=http://lakehouse:8102
# Sync/compaction tuning for the lakehouse pipelines.
LAKEHOUSE_SYNC_INTERVAL_SECONDS=900
LAKEHOUSE_COMPACT_MIN_FILES=4
# MinIO root credentials — REQUIRED by docker-compose (no minioadmin defaults).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── File Storage (S3 / MinIO) ─────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=remitflow-uploads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# REQUIRED by python-lakehouse pipeline (no default; service refuses to start
# without it). Use a high-entropy random value in production; rotating it
# changes all masked PII hashes.
PII_SALT=

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@remitflow.io
SMTP_TLS=false
# Dev-only: disable SMTP TLS certificate verification (e.g. MailHog/self-signed).
# Throws at startup if set to true while NODE_ENV=production.
SMTP_TLS_INSECURE=false

# ── SMS ───────────────────────────────────────────────────────────────────────
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Push Notifications (Expo) ─────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ── FX Rates ─────────────────────────────────────────────────────────────────
FX_PROVIDER=openexchangerates
OPENEXCHANGERATES_APP_ID=
FX_UPDATE_INTERVAL_SECONDS=300

# ── Compliance ────────────────────────────────────────────────────────────────
FATF_TRAVEL_RULE_THRESHOLD_USD=1000
STR_AUTO_GENERATE_THRESHOLD_USD=10000
KYC_TIER1_DAILY_LIMIT_USD=500
KYC_TIER2_DAILY_LIMIT_USD=10000
KYC_TIER3_DAILY_LIMIT_USD=50000
HIGH_RISK_COUNTRIES=KP,IR,SY,CU,VE

# ── Observability (OpenTelemetry) ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=remitflow-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# ── Prometheus ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
METRICS_PATH=/metrics

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_BNPL=true
FEATURE_CBDC=false
FEATURE_OPEN_BANKING=true
FEATURE_AI_SUPPORT=true
FEATURE_WEBAUTHN=true
FEATURE_SOCIAL_LEDGER=true

# ── Security ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
HELMET_CSP=true
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-min-32-chars

# ── WebAuthn ─────────────────────────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=RemitFlow
WEBAUTHN_ORIGIN=http://localhost:3000

# ── Post-Quantum Cryptography ─────────────────────────────────────────────────
PQ_CRYPTO_SVC_URL=http://rust-pq-crypto:8200
PQ_ALGORITHM=kyber1024
PQ_ENABLED=false

# ── Microservice URLs ─────────────────────────────────────────────────────────
GO_AGENT_INTELLIGENCE_URL=http://go-agent-intelligence:8100
GO_FX_HEDGING_URL=http://go-fx-hedging:8101
GO_CBDC_SETTLEMENT_URL=http://go-stablecoin-settlement:8102
GO_OPEN_BANKING_URL=http://go-open-banking:8120
RUST_FRAUD_GNN_URL=http://rust-fraud-gnn:8300
RUST_SOCIAL_LEDGER_URL=http://rust-social-ledger:8301
RUST_AML_ENGINE_URL=http://aml-engine:8302
PYTHON_FRAUD_ML_URL=http://python-fraud-ml:8400
PYTHON_AML_SCORER_URL=http://python-aml-scorer:8401
PYTHON_STR_GENERATOR_URL=http://python-str-generator:8402
PYTHON_LAKEHOUSE_URL=http://python-lakehouse:8403
TENANT_MANAGEMENT_URL=http://tenant-management:8500
