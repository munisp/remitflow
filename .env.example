# =============================================================================
# RemitFlow Production Environment Configuration
# =============================================================================
# COPY THIS FILE TO .env AND FILL IN ALL VALUES BEFORE DEPLOYMENT
# NEVER commit .env to version control. Use AWS Secrets Manager / Dapr / Vault.
# =============================================================================

# ─── Global ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://remitflow:CHANGE_ME@localhost:5432/remitflow
ENVIRONMENT=production   # sandbox | staging | production
LOG_LEVEL=INFO

# ─── Compliance ML (Port 8097) ──────────────────────────────────────────────
COMPLYADVANTAGE_API_KEY=ca_live_xxxxxxxxxxxxxxxx
COMPLYADVANTAGE_BASE_URL=https://api.complyadvantage.com
DOWJONES_API_KEY=dj_xxxxxxxxxxxxxxxx
DOWJONES_API_SECRET=xxxxxxxxxxxxxxxx
DOWJONES_BASE_URL=https://api.dowjones.com

# ─── KYC Liveness (Port 8095) ───────────────────────────────────────────────
UNIFACE_MODEL_PATH=/models/minifasnet.onnx
DEEPFACE_BACKEND=arcface

# ─── M-Pesa Payment Gateway ─────────────────────────────────────────────────
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=xxxxxxxxxxxxxxxx
MPESA_CONSUMER_SECRET=xxxxxxxxxxxxxxxx
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=xxxxxxxxxxxxxxxx
MPESA_INITIATOR_NAME=remitflow_api
MPESA_INITIATOR_PASSWORD=xxxxxxxxxxxxxxxx
MPESA_SECURITY_CREDENTIAL=xxxxxxxxxxxxxxxx   # base64-encoded encrypted credential
MPESA_CALLBACK_BASE_URL=https://api.remitflow.com

# ─── FX Engine (Port 8093) ──────────────────────────────────────────────────
EXCHANGERATE_API_KEY=xxxxxxxxxxxxxxxx
OPENEXCHANGERATES_APP_ID=xxxxxxxxxxxxxxxx
DEFAULT_SPREAD_BPS=150
RATE_MAX_AGE_SECONDS=300

# ─── AML Scorer (Port 8096) ─────────────────────────────────────────────────
MODEL_PATH=/models/aml_model.joblib
MODEL_METADATA_PATH=/models/aml_model_metadata.json
MAX_MODEL_AGE_DAYS=30

# ─── Core Banking Adapter (Port 8092) ────────────────────────────────────────
CORE_BANKING_BASE_URL=https://api.treasuryprime.com
CORE_BANKING_API_KEY=xxxxxxxxxxxxxxxx
CORE_BANKING_API_SECRET=xxxxxxxxxxxxxxxx

# ─── Rust Transaction Processor (Port 8081) ──────────────────────────────────
# Uses DATABASE_URL above

# ─── Kafka / Fluvio (Event Streaming) ─────────────────────────────────────────
KAFKA_BROKERS=kafka-1.remitflow.com:9092,kafka-2.remitflow.com:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_USERNAME=remitflow-producer
KAFKA_PASSWORD=xxxxxxxxxxxxxxxx
FLUVIO_TOPIC=remitflow-transactions

# ─── Redis (Caching / Rate Limiting) ────────────────────────────────────────
REDIS_URL=redis://redis.remitflow.com:6379
REDIS_PASSWORD=xxxxxxxxxxxxxxxx

# ─── Sentry / Error Tracking ────────────────────────────────────────────────
SENTRY_DSN=https://xxxxxxxxxxxxxxxx@xxxxxxxxxxxxxxxx.ingest.sentry.io/xxxxxxxxxxxxxxxx

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.remitflow.com:4317
OTEL_SERVICE_NAME=remitflow
PROMETHEUS_PORT=9090
