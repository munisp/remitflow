# ============================================================
# RemitFlow — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file: cp DEPLOYMENT.env.template .env
#   2. Fill in all values marked with CHANGE_ME
#   3. NEVER commit .env to git (it's in .gitignore)
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (MySQL) ─────────────────────────────────────────
DATABASE_URL=mysql://remitflow:CHANGE_ME@db:3306/remitflow
DB_ROOT_PASSWORD=CHANGE_ME_ROOT
DB_USER=remitflow
DB_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS

# ── JWT / Session ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS

# ── Manus OAuth ───────────────────────────────────────────────
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
OWNER_OPEN_ID=your-owner-open-id
OWNER_NAME=RemitFlow Admin

# ── Manus Forge API ───────────────────────────────────────────
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=CHANGE_ME
VITE_FRONTEND_FORGE_API_KEY=CHANGE_ME
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME

# ── Analytics (optional) ──────────────────────────────────────
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ── Microservices ─────────────────────────────────────────────
FX_ENGINE_URL=http://fx-engine:8081
FRAUD_ML_URL=http://fraud-ml:8082
AML_ENGINE_URL=http://aml-engine:8083

# ── App Branding ─────────────────────────────────────────────
VITE_APP_TITLE=RemitFlow
VITE_APP_LOGO=
