# ─── RemitFlow — npm Security Configuration ────────────────────────────────────
# Enforces supply-chain integrity and prevents dependency confusion attacks.

# Enforce lockfile integrity — fail if package-lock.json is out of sync
ci=true

# Require package integrity checksums (SHA-512)
package-lock=true

# Disallow scripts from running during install (prevents supply chain RCE)
ignore-scripts=false
# NOTE: set to true in CI: npm ci --ignore-scripts

# Audit level — fail on high or critical vulnerabilities
audit-level=high

# Enforce strict SSL certificate validation
strict-ssl=true

# Disable telemetry
no-update-notifier=true

# Prevent accidental publishing of private packages
access=restricted
